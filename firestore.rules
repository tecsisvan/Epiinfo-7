rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Solo usuarios que el administrador creó en Firebase Authentication (usuario + contraseña o Google).
    // La app no tiene registro público, así que "estar autenticado" equivale a "fue creado por el administrador".
    function autorizado() { return request.auth != null; }

    match /registros/{formId}/items/{recordId} {
      allow read, write: if autorizado();
    }
  }
}
